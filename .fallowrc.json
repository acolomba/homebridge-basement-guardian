{
  "entry": ["src/index.ts"],
  "ignoreDependencies": ["aedes", "mqtt", "ws"],
  "ignoreFindings": [
    "src/device/events.ts",
    "src/device/health.ts",
    "src/device/family.ts",
    "src/device/gemini.ts",
    "src/device/halo.ts",
    "src/accessories/basementGuardian.ts",
    "src/accessories/services.ts",
    "src/persistence/accessoryContext.ts",
    "src/cloud/sigv4.ts"
  ],
  "ignorePatterns": ["dist-test/**"],
  "production": false,
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxUnitSize": 60,
    "maxCrap": 0
  },
  "duplicates": {
    "threshold": 3
  },
  "includeEntryExports": true,
  "rules": {
    "private-type-leaks": "error"
  }
}
