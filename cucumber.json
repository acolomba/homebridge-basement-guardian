{
  "default": {
    "paths": ["features/**/*.feature"],
    "import": ["dist-test/features/support/**/*.js"],
    "tags": "not @real",
    "format": ["summary"]
  },
  "real": {
    "paths": ["features/real-pump/**/*.feature"],
    "import": ["dist-test/features/real-pump/**/*.js"],
    "tags": "@real and @read-only",
    "format": ["summary"]
  }
}
