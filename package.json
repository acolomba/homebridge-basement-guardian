{
  "name": "homebridge-basement-guardian",
  "displayName": "Basement Guardian",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "A Homebridge plugin for monitoring and protecting basements.",
  "author": "Alessandro Colomba",
  "license": "Apache-2.0",
  "homepage": "https://github.com/acolomba/homebridge-basement-guardian#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/acolomba/homebridge-basement-guardian.git"
  },
  "bugs": {
    "url": "https://github.com/acolomba/homebridge-basement-guardian/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "check": "npm run typecheck && npm run lint && npm run fallow && npm run format:check && npm test",
    "fallow": "fallow dead-code --fail-on-issues --format human && fallow health --fail-on-issues --format human && fallow dupes --fail-on-issues --format human",
    "format": "prettier --write \"**/*.{js,json,mjs,ts}\"",
    "format:check": "prettier --check \"**/*.{js,json,mjs,ts}\"",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "prefallow": "npm run build",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "npm run build && node --test tests/plugin.test.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {
    "homebridge-lib": "^8.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-sonarjs": "^4.0.3",
    "fallow": "^3.16.0",
    "globals": "^17.6.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "prettier": "3.9.6",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
