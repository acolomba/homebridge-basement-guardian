{
  "name": "homebridge-basement-guardian",
  "displayName": "Basement Guardian",
  "type": "module",
  "version": "0.1.0",
  "private": false,
  "description": "A Homebridge plugin for monitoring and protecting basements.",
  "author": "Alessandro Colomba",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/acolomba/homebridge-basement-guardian#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/acolomba/homebridge-basement-guardian.git"
  },
  "bugs": {
    "url": "https://github.com/acolomba/homebridge-basement-guardian/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "engines": {
    "node": "^22.10.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "build:test": "rimraf ./dist-test && tsc -p tsconfig.test.json",
    "check": "npm run typecheck && npm run lint && npm run fallow && npm run format:check && npm test",
    "fallow": "fallow dead-code --fail-on-issues --format human && fallow health --fail-on-issues --format human && fallow dupes --fail-on-issues --format human",
    "format": "prettier --write \"**/*.{js,json,mjs,ts}\"",
    "format:check": "prettier --check \"**/*.{js,json,mjs,ts}\"",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "prefallow": "npm run build",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "npm run test:unit && npm run test:cucumber",
    "test:coverage:all": "npm run build:test && node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include=\"dist-test/src/**/*.js\" \"dist-test/test/**/*.test.js\"",
    "test:coverage:direct": "npm run build:test && node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include",
    "test:cucumber": "npm run build:test && cucumber-js",
    "test:unit": "npm run build:test && node --test \"dist-test/test/**/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "watch": "npm run build && npm link && nodemon"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^10.0.1",
    "@homebridge/hap-nodejs": "2.2.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.2.0",
    "aedes": "^1.1.1",
    "eslint": "^10.9.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-sonarjs": "^4.0.3",
    "fallow": "^3.16.0",
    "globals": "^17.6.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "prettier": "3.9.6",
    "rimraf": "^6.1.3",
    "strong-mock": "^9.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "mqtt": "^5.15.2",
    "undici": "^7.29.1"
  }
}
