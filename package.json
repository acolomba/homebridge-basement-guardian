{
  "name": "homebridge-basement-guardian",
  "displayName": "Basement Guardian",
  "type": "module",
  "version": "0.1.1",
  "private": false,
  "description": "A Homebridge plugin for monitoring and protecting basements.",
  "author": "Alessandro Colomba",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/acolomba/homebridge-basement-guardian#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acolomba/homebridge-basement-guardian.git"
  },
  "bugs": {
    "url": "https://github.com/acolomba/homebridge-basement-guardian/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "engines": {
    "node": "^22.10.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "build:test": "rimraf ./dist-test && tsc -p tsconfig.test.json",
    "check": "npm run --silent check:static && npm run --silent build:test && npm run --silent test:unpaired:compiled && cucumber-js && npm run --silent test:coverage:direct:compiled -- --all --lcov coverage/direct.lcov",
    "check:commit": "npm run --silent check:static && npm run --silent build:test && npm run --silent test:unpaired:compiled && npm run --silent test:coverage:direct:compiled -- --staged",
    "check:static": "node scripts/run-parallel.mjs typecheck lint lint:workflows fallow format:check test:corresponding",
    "fallow": "fallow dead-code --fail-on-issues --format human && fallow dead-code --no-production --circular-deps --re-export-cycles --fail-on-issues --format human && fallow health --fail-on-issues --format human && fallow dupes --threshold 3 --format human",
    "format": "prettier --write \"**/*.{js,json,mjs,ts}\" --cache --cache-strategy content",
    "format:check": "prettier --check \"**/*.{js,json,mjs,ts}\" --cache --cache-strategy content",
    "lint": "eslint . --max-warnings=0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "lint:workflows": "node scripts/check-workflow-install-scripts.mjs",
    "prefallow": "npm run build",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "npm run test:unit && npm run test:cucumber",
    "test:corresponding": "node scripts/check-corresponding-tests.mjs",
    "test:coverage": "npm run test:coverage:direct:all",
    "test:coverage:all": "npm run build:test && node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include=\"dist-test/src/**/*.js\" \"dist-test/test/**/*.test.js\"",
    "test:coverage:direct": "npm run --silent build:test && node scripts/test-coverage-direct.mjs",
    "test:coverage:direct:all": "npm run --silent test:coverage:direct -- --all --lcov coverage/direct.lcov",
    "test:coverage:direct:commit": "npm run --silent test:coverage:direct -- --staged",
    "test:coverage:direct:compiled": "node scripts/test-coverage-direct.mjs",
    "test:cucumber": "npm run build:test && cucumber-js",
    "test:unit": "npm run build:test && node --test --test-reporter=./scripts/test-reporter.mjs \"dist-test/test/**/*.test.js\"",
    "test:unpaired": "npm run --silent build:test && npm run --silent test:unpaired:compiled",
    "test:unpaired:compiled": "node scripts/test-coverage-direct.mjs --unpaired",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typescript/src.tsbuildinfo && tsc -p tsconfig.test.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typescript/test.tsbuildinfo",
    "watch": "npm run build && npm link && nodemon"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^10.0.1",
    "@homebridge/hap-nodejs": "2.2.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.2.0",
    "aedes": "^1.1.1",
    "eslint": "^10.9.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^74.0.0",
    "fallow": "3.27.0",
    "globals": "^17.6.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "prettier": "3.9.6",
    "rimraf": "^6.1.3",
    "strong-mock": "^9.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "mqtt": "^5.15.2",
    "undici": "^7.29.1"
  }
}
