{
  "model_profile": "quality",
  "model_profile_overrides": {
    "codex": {
      "opus": "gpt-6-astra",
      "sonnet": "gpt-6-sol",
      "haiku": "gpt-6-luna"
    }
  },
  "git": {
    "branching_strategy": "phase",
    "create_tag": false,
    "phase_branch_template": "features/phase-{phase}-{slug}",
    "milestone_branch_template": "features/{milestone}-{slug}",
    "quick_branch_template": "features/quick-{slug}"
  },
  "workflow": {
    "context_guard_mode": "auto",
    "ui_phase": false,
    "ui_safety_gate": false,
    "ui_review": false,
    "test_command": "npm run check",
    "use_worktrees": false,
    "research_before_questions": true,
    "nyquist_validation": true,
    "ai_integration_phase": true,
    "research": true,
    "pattern_mapper": true,
    "tdd_mode": true,
    "code_review": true,
    "code_review_depth": "standard",
    "plan_check": true,
    "verifier": true,
    "auto_advance": false,
    "compact_content": false,
    "skip_discuss": false,
    "test_gate_timeout": 2400,
    "node_repair": true,
    "node_repair_budget": 2,
    "api_coverage_gate": true,
    "human_verify_mode": "end-of-phase",
    "text_mode": false,
    "discuss_mode": "discuss",
    "code_review_command": null,
    "plan_bounce": false,
    "plan_bounce_script": null,
    "plan_bounce_passes": 2,
    "auto_prune_state": false,
    "post_planning_gaps": true,
    "security_enforcement": true,
    "security_asvs_level": 1,
    "security_block_on": "high"
  },
  "effort": {
    "agent_overrides": {
      "gsd-planner": "max"
    }
  },
  "code_quality": {
    "fallow": {
      "enabled": true,
      "scope": "repo",
      "mcp": true,
      "profile": "standard"
    }
  },
  "agent_skills": {
    "gsd-discuss-phase": [
      ".agents/skills/typescript-unit-tests",
      ".agents/skills/cucumber"
    ],
    "gsd-advisor-researcher": [
      ".agents/skills/typescript-unit-tests",
      ".agents/skills/cucumber"
    ],
    "gsd-assumptions-analyzer": [
      ".agents/skills/typescript-unit-tests",
      ".agents/skills/cucumber"
    ]
  },
  "mode": "interactive",
  "claude_md_assembly": {
    "mode": "link",
    "blocks": {
      "project": "embed"
    }
  },
  "claude_md_path": "AGENTS.md",
  "intel": {
    "enabled": false
  },
  "graphify": {
    "enabled": false,
    "auto_update": false
  },
  "commit_docs": true,
  "plan_review": {
    "source_grounding": true,
    "source_grounding_authority": "grep"
  },
  "hooks": {
    "context_warnings": true
  },
  "parallelization": true,
  "search_gitignored": false,
  "brave_search": false,
  "firecrawl": false,
  "exa_search": false,
  "tavily_search": false,
  "ref_search": false,
  "perplexity": false,
  "jina": false,
  "ship": {
    "pr_body_sections": []
  },
  "project_code": null,
  "phase_naming": "sequential",
  "resolve_model_ids": "omit",
  "runtime": "claude",
  "granularity": "standard",
  "context_window": 1000000
}
