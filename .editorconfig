root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 160

[*.{js,mjs,ts}]
indent_size = 2
max_line_length = 160

[*.json]
indent_size = 2

[*.md]
max_line_length = off

[*.sh]
end_of_line = lf
indent_size = 4

[*.{yaml,yml}]
indent_size = 2
max_line_length = off
