# Local development only. Copy to .env, which is gitignored.
# Used by ./dev/hb to render the Homebridge container's config.

# Basement Guardian account. Homebridge stores the password in plain text in
# the generated config.json, exactly as it does for a real installation.
BG_EMAIL=you@example.com
BG_PASSWORD=

# Config UI login, seeded on first run only. Change it in the UI afterwards;
# a later `./dev/hb up` will not overwrite it.
BG_UI_USER=admin
BG_UI_PASSWORD=admin

# Lets the UI read characteristic values, which is what `./dev/hb observe`
# uses. It also allows unauthenticated HAP reads from the local network. Every
# characteristic this plugin publishes is read-only, so what is exposed is
# telemetry, not control. Set to 0 to turn it off.
BG_INSECURE=1

# Optional. Change the MAC or PIN only if you want a second, separate bridge.
#BG_BRIDGE_NAME=Basement Guardian Dev
#BG_BRIDGE_MAC=0E:BA:5E:3E:00:01
#BG_BRIDGE_PORT=51826
#BG_BRIDGE_PIN=031-45-154
#BG_POLL_INTERVAL=300
